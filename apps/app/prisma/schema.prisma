  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  definitionId String
  definition   ContributorAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  valueBoolean Boolean?
  valueNumber  Float?
  valueString  String?
  valueDate    DateTime? @db.Date
  valueJson    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, definitionId])
  @@index([definitionId])
  @@index([definitionId, valueBoolean])
  @@index([definitionId, valueNumber])
  @@index([definitionId, valueString])
  @@map("contributor_attribute_value")
}

// --------------------
// Checkpoint Modules
// --------------------

enum ProfileModuleStatus {
  locked
  in_progress
  completed
  quality

  @@map("profile_module_status")
}

model ContributorProfileModuleProgress {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // clé stable du module, ex: "demography", "finance", "social_networks"
  moduleKey String

  // label FR affichable (facultatif mais pratique pour backoffice)
  moduleLabel String?

  // état
  status ProfileModuleStatus @default(in_progress)

  // progression (0..100) optionnel mais très utile pour l’UI
  completionPercent Int @default(0)

  // nombre de champs complétés / attendus (optionnels)
  answeredCount Int @default(0)
  totalCount    Int @default(0)

  // points
  pointsAwarded Int @default(0) // cumul attribué pour ce module (anti-double reward)

  // dates
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  qualityAt   DateTime?

  updatedAt DateTime @updatedAt

  // 1 ligne par user et par module
  @@unique([userId, moduleKey])
  @@index([userId])
  @@index([moduleKey])
  @@index([status])
  @@map("contributor_profile_module_progress")
}

//dynamisation des points et des règles de complétion
model ContributorModuleRewardConfig {
  id String @id @default(uuid())

  moduleKey   String @unique @map("module_key")
  moduleLabel String @map("module_label")
  order       Int    @map("order")

  rewardXof Int     @default(0) @map("reward_xof")
  isActive  Boolean @default(true) @map("is_active")

  dependsOn String? @map("depends_on")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@index([isActive])
  @@map("contributor_module_reward_config")
}

// enums optionnels
enum BlogPostStatus {
  draft
  published
  archived
}

model BlogTopic {
  id       String  @id @default(uuid())
  key      String  @unique @map("key") // ex: "fundamentals"
  label    String  @map("label") // ex: "Fundamentals"
  isActive Boolean @default(true) @map("is_active")
  order    Int     @default(0) @map("order")

  posts BlogPost[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("blog_topic")
}

model BlogPost {
  id      String    @id @default(uuid())
  topicId String    @map("topic_id")
  topic   BlogTopic @relation(fields: [topicId], references: [id])

  title       String         @map("title")
  slug        String         @unique @map("slug") // ex: "5-short-interest-metrics"
  excerpt     String?        @map("excerpt")
  content     String         @map("content") // markdown ou html (simple)
  coverPath   String?        @map("cover_path") // ✅ on stocke le path storage
  status      BlogPostStatus @default(draft) @map("status")
  publishedAt DateTime?      @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([topicId])
  @@index([status, publishedAt])
  @@map("blog_post")
}

model Invoice {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  invoiceNumber String @unique @default(dbgenerated("public.next_invoice_number()")) @map("invoice_number")
  status        String @default("issued")

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // ✅ Montant
  amountCents Int    @default(0) @map("amount_cents")
  currency    String @default("EUR") @map("currency")

  workspaceCreditTransactionId String? @map("workspace_credit_transaction_id") @db.Uuid
  workspacePlanSubscriptionId  String? @map("workspace_plan_subscription_id") @db.Uuid

  workspaceCreditTransaction WorkspaceCreditTransaction? @relation(fields: [workspaceCreditTransactionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  workspacePlanSubscription  WorkspacePlanSubscription?  @relation(fields: [workspacePlanSubscriptionId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  metadata Json?

  @@unique([workspaceCreditTransactionId], map: "uniq_invoice_wct")
  @@unique([workspacePlanSubscriptionId], map: "uniq_invoice_wps")
  @@map("invoice")
}
