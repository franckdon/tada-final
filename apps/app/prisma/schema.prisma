model ContributorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 1) gender
  gender Gender?

  // 2) birthDate (age computed in app)
  birthDate DateTime? @db.Date

  // 3) maritalStatus
  maritalStatus MaritalStatus?

  // 4) hasChildren + childrenCount
  hasChildren   Boolean?
  childrenCount Int?

  // 5) residenceCountryCode (ISO2)
  residenceCountryCode String? @db.VarChar(2)

  // 6) residenceCity (normalized string)
  residenceCity String?

  // 7) areaType
  areaType AreaType?

  // 8) cityResidenceDuration
  cityResidenceDuration ResidenceDuration?

  // 9) nationality1Code
  nationality1Code String? @db.VarChar(2)

  // 10) hasValidIdOrPassport
  hasValidIdOrPassport Boolean?

  // 11) educationLevel
  educationLevel EducationLevel?

  // 12) lastDegree
  lastDegree DegreeLevel?

  // 13) speaksMultipleLanguages + languagesJson
  speaksMultipleLanguages Boolean?
  // format recommandé:
  // [{ code:"fr", level:"bilingual" }, { code:"di", level:"advanced" }]
  languagesJson           Json?

  // 14) employmentStatus
  employmentStatus EmploymentStatus?

  // 15) sector
  sector String?

  // 16) jobTitle
  jobTitle String?

  // 17) experienceDuration
  experienceDuration ExperienceDuration?

  // 18) incomeBracketXof
  incomeBracketXof IncomeBracketXof?

  // 19) hasBankAccount
  hasBankAccount Boolean?

  // 20) hasMobileMoney + operatorsJson
  hasMobileMoney           Boolean?
  // format recommandé: ["orange_money","mtn_momo","moov_money"]
  mobileMoneyOperatorsJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index pratiques pour ciblage
  @@index([residenceCountryCode, residenceCity])
  @@index([gender, birthDate])
  @@index([employmentStatus, sector])
  @@index([incomeBracketXof, hasBankAccount, hasMobileMoney])
  @@map("contributor_profile")
}

